# ====== 服务端基础配置 ======
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# ====== 存储后端 ======
# 可选: local | tos
STORAGE_BACKEND=local

# local 模式
LOCAL_STORAGE_DIR=/var/lib/agent-handoff/bundles
LOCAL_INDEX_DB=/var/lib/agent-handoff/index.sqlite

# tos 模式(火山引擎对象存储)
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_BUCKET=agent-handoff
TOS_ACCESS_KEY=your_ak
TOS_SECRET_KEY=your_sk
TOS_PREFIX=bundles

# ====== 索引 ======
# 是否启用 SQLite 索引(用于管理后台/精确统计)
# local 模式默认 on,tos 模式默认 on
ENABLE_INDEX=true

# ====== 业务参数 ======
# 单 bundle 大小上限(bytes)
MAX_BUNDLE_SIZE=52428800
# 默认过期时间(秒),客户端可覆盖
DEFAULT_EXPIRES_IN=604800
# 是否一次性消费(GET 一次后立即删除)
ONE_TIME_CONSUME=false
# bundle id 长度(hex 字符数,默认 32 = 16 字节)
BUNDLE_ID_LENGTH=32

# ====== 安全 ======
# 管理操作(强制删除)的 token
ADMIN_TOKEN=change-me-to-a-long-random-string

# ====== 速率限制 ======
# 每 IP 每分钟上传/拉取次数
RATE_LIMIT_PER_MIN=30

# ====== 清理任务 ======
# 清理任务运行间隔(秒)
CLEANUP_INTERVAL=21600
